# ─────────────────────────────────────────────────────────────
# Turso (libSQL) — the waitlist database.
#
# These are VERCEL ENVIRONMENT VARIABLES ONLY. Never commit real
# values. Copy this file to `.env.local` and fill it in locally.
#
#   turso db create waitlist        → prints a URL + token
#   turso db shell . schema/001_waitlist.sql   → create the table
#
# The site NEVER emails anyone. The waitlist is exported and handed
# to a real ESP at launch. See README.md § "Getting the waitlist out".
# ─────────────────────────────────────────────────────────────

# libSQL over HTTP. Example shape:
#   libsql://your-db-name-your-org.turso.io
TURSO_DATABASE_URL=

# The auth token for that database. Vercel → Settings → Env Vars.
TURSO_AUTH_TOKEN=


# ─────────────────────────────────────────────────────────────
# Google Forms — the "what should we build next" feedback form.
#
# These are PUBLIC identifiers, not secrets: the form id and the
# entry id appear in the page source. There is no API key and no
# service account in this path.
#
#   1 — forms.google.com → New form → one question:
#       "What should XR do next?"
#   2 — Menu (⋮) → Get prefilled link → copy the id out of the URL
#       (it looks like entry.<the number from the prefilled link>)
#   3 — Fill in the two values below.
#
# If only FORM_ID is set, Google's own form is embedded instead.
# If neither is set, the section says it is not connected yet.
#
# The form already exists in the owner's Drive:
#   https://docs.google.com/forms/d/e/1vN0I_PtIQDCemoAgafAQwdMG5Hsm5c5eZlJaVbr3vu8/edit
# Add one question ("What should XR do next?"), publish it with Send, then
# take the entry id from Menu -> Get prefilled link.
# Leave both blank until the form has a question and has been published
# with Send. A published form's id is not the same as the Drive file id,
# so take it from the form's own link after publishing.
NEXT_PUBLIC_GOOGLE_FORM_ID=
NEXT_PUBLIC_GOOGLE_FORM_ENTRY=

# ─────────────────────────────────────────────────────────────
# GitHub — optional.
#
# The star count on the site is read live from the GitHub API. An
# unauthenticated request is limited to 60 an hour per IP, and Vercel's
# IPs are shared, so the limit is routinely hit and the count comes back
# unknown. The site then shows a dash — never a wrong number.
#
# A classic token with NO scopes is enough for a public repository:
#   github.com/settings/tokens  ->  Generate new token (classic)
#   -> leave every scope empty  ->  Generate token
#
# It only ever reads one public repository.
#
GITHUB_TOKEN=
